{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug bench_sparse_vllm",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/bench_sparse_vllm.py",
      "args": [
        "--model_path",
        "${workspaceFolder}/models/Qwen2.5-0.5B-Instruct/",
        "--lengths",
        "8000",
        "--batch_sizes",
        "2",
        "--methods",
        "omnikv,quest",
        "--hyper_params",
        "{\"gpu_memory_utilization\": 0.8, \"output_len\": 2}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug bench_sparse_vllm (vanilla vs snapkv)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/bench_sparse_vllm.py",
      "args": [
        "--model_path",
        "${workspaceFolder}/models/Qwen2.5-0.5B-Instruct/",
        "--lengths",
        "1000",
        "--batch_sizes",
        "2",
        "--methods",
        "vanilla,snapkv",
        "--hyper_params",
        "{\"gpu_memory_utilization\": 0.9}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug bench_sparse_vllm (attnpredict)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/bench_sparse_vllm.py",
      "args": [
        "--model_path",
        "models/llama-3.1-8B-Instruct",
        "--lengths",
        "8000",
        "--batch_sizes",
        "2",
        "--methods",
        "attnpredict",
        "--output_len",
        "32",
        "--hyper_params",
        "{\"gpu_memory_utilization\": 0.8, \"chunk_prefill_size\": 4096, \"tensor_parallel_size\": 1, \"attnpredict_model_path\": \"predictor/CNN_llama3.1_alltask_5case/best_model.pth\", \"attnpredict_history_steps\": 64, \"attnpredict_pooling_block_size\": 16, \"num_top_tokens\": 4096, \"num_sink_tokens\": 64, \"num_recent_tokens\": 512}"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Debug trace_qkv_similarity_longbench (smoke)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/analysis/trace_qkv_similarity_longbench.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "--model_paths",
        "${workspaceFolder}/models/Qwen2.5-0.5B-Instruct",
        "--smoke",
        "--sample_num",
        "1",
        "--max_new_tokens",
        "2",
        "--max_prefill_tokens",
        "256",
        "--prefill_sample_tokens",
        "32",
        "--temporal_lags",
        "1,2",
        "--output_dir",
        "${workspaceFolder}/outputs/qkv_similarity_trace_debug"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
