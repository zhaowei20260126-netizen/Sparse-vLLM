    color: "#854442"
  - name: CROP Throughput
    category: Unit Throughputs
    shortName: CROP
    sku: public
    id: ROP.TriageAC.crop__throughput.avg.pct_of_peak_sustained_elapsed
    storageType: uint8
    color: "#afB159"
  # Compute In Flight
  - name: Sync Compute In Flight
    category: Compute In Flight
    sku: public
    id: FE_A.TriageAC.gr__compute_cycles_active_queue_sync.avg.pct_of_peak_sustained_elapsed
    storageType: uint8
    color: "#FE7F9C"
  - name: Async Compute In Flight
    category: Compute In Flight
